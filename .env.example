# Copy to .env and fill in. .env is git-ignored.

# --- PostgreSQL (used by docker compose and by the host) -------------------------------
POSTGRES_USER=leads
POSTGRES_PASSWORD=change-me
POSTGRES_DB=leads
DB_PORT=5432
# Lead dashboard
DASHBOARD_PORT=3300
# Metabase (optional dashboard profile)
METABASE_PORT=3000
# Host-side URL (uv run alembic / uv run leads). The worker container overrides this
# with the internal hostname "db".
DATABASE_URL=postgresql+psycopg://leads:change-me@localhost:5432/leads

# --- Prefect ---------------------------------------------------------------------------
PREFECT_API_URL=http://localhost:4200/api

# --- Time zone for containers (keep equal to `timezone` in config/settings.yaml) -------
TZ=UTC

# --- Google (Gmail drafts + Sheet) -----------------------------------------------------
# Defaults: secrets/client_secret.json and secrets/token.json
# GOOGLE_CLIENT_SECRET_FILE=secrets/client_secret.json
# GOOGLE_TOKEN_FILE=secrets/token.json
GMAIL_USER_ID=me
GOOGLE_SHEET_ID=
# The Gmail account that should hold the drafts; any other account is refused
GMAIL_ACCOUNT=

# --- AI email writer (free key: console.groq.com) ---------------------------------------
GROQ_API_KEY=
# Backup when the free Groq limit is used up or Groq is down (free key: aistudio.google.com/apikey).
GEMINI_API_KEY=
# Optional second backup; switch it on under ai.fallbacks in config/settings.yaml (openrouter.ai/keys).
OPENROUTER_API_KEY=

# --- Registry API keys (optional, per source) ------------------------------------------
# Hugging Face read token, for the gated Foursquare OS Places dataset
HF_TOKEN=
COMPANIES_HOUSE_API_KEY=
INSEE_API_KEY=
ABN_LOOKUP_GUID=

# --- Logging ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false
# Sentry (free plan): paste the project's DSN to get an email when a job crashes.
# Reports hold the error and stack trace only, no lead data. Empty = off.
SENTRY_DSN=
SENTRY_ENVIRONMENT=server

# --- Behaviour overrides (optional; see config/settings.yaml) --------------------------
# BATCH__DRAFTS_PER_DAY=100
# INCLUDE_UNKNOWN_AGE=true
# On a laptop with little disk: do not start a whole-world collect when the worker starts.
# COLLECT__ON_START=false

# --- Sender details and drafts ---------------------------------------------------------
# Shown in every email signature. Remove the leading "# " and fill in the real values.
# A line left commented keeps the value from config/settings.yaml.
# SENDER__SENDER_NAME=Your Full Name
# SENDER__COMPANY=Clicksone
# SENDER__COMPANY_WEBSITE=https://www.yourcompany.com
# SENDER__COMPANY_PHONE=+92 300 1234567
# SENDER__COMPANY_ADDRESS=Street and number, City, Postcode, Country
# SENDER__MOCKUP_LINK=https://www.yourcompany.com/portfolio
# OUTREACH__PRICE=$199
# OUTREACH__DELIVERY_DAYS=7
# true: the 07:00 run writes up to BATCH__DRAFTS_PER_DAY Gmail drafts by itself.
# Nothing is ever sent: a person presses Send in Gmail.
# OUTREACH__AUTO_DRAFTS=false
# BATCH__DRAFTS_PER_DAY=50
